# Pan, zoom and hover the passive tree of a cluster-heavy build (allflame_exp_001): idle frames, node tooltips with stat differences (allocated and unallocated nodes, a jewel socket), sweeping the cursor over the tree, zooming all the way out and back in, dragging, and searching.
screen 1920 1080
fixture userdir=../fixtures/user
frames 2
load-build "Builds/allflame_exp_001.xml"
frames 4
wait-idle
step idle
move 1100 540
frames 20
expect-no-recalc
step zoom_in
move 1290 250
wheel up 1
frames 2
wheel up 1
frames 2
wheel up 1
frames 2
step hover_nodes
# Intelligence (unallocated), Pain Attunement, a jewel socket, Solipsism, Dexterity (118 dependants)
move 1245 313
frames 3
move 1340 212
frames 3
move 1285 302
frames 3
move 1087 540
frames 3
move 1213 195
frames 3
expect-misc 5
expect-no-recalc
step sweep
move 450 150
frames 1
move 750 150
frames 1
move 1050 150
frames 1
move 1350 150
frames 1
move 1650 150
frames 1
move 1650 400
frames 1
move 1350 400
frames 1
move 1050 400
frames 1
move 750 400
frames 1
move 450 400
frames 1
move 450 650
frames 1
move 750 650
frames 1
move 1050 650
frames 1
move 1350 650
frames 1
move 1650 650
frames 1
move 1650 900
frames 1
move 1350 900
frames 1
move 1050 900
frames 1
move 750 900
frames 1
move 450 900
frames 1
step zoom_out
move 1100 540
wheel down 3
frames 3
wheel down 3
frames 3
wheel down 3
frames 3
step zoomed_out_idle
frames 10
step drag
key-down LEFTBUTTON
move 1080 530
frames 1
move 1040 510
frames 1
move 1000 490
frames 1
move 960 470
frames 1
move 920 450
frames 1
move 880 430
frames 1
key-up LEFTBUTTON
frames 2
expect-no-recalc
step search
key-down CTRL
press f
key-up CTRL
frames 1
type "life"
frames 3
press ESCAPE
frames 2
