screen 1280 800 dpi 1.0
# U30: skill sets (L99-110, L673-681, L1443-1451, L1478-1502). two_sets.xml has a second set
# ("Leap set"): the set selector is enabled; pick the second set (SetActiveSkillSet: the group
# list, the displayed group, SyncLoadouts; AddUndoState; recalc), Ctrl+Z back to the first set,
# then the "Manage..." popup (the SkillSetListControl stand-in and the Done button), closed with
# Done (one screen: the popup is centred vertically).
#! u30-expect-skills activeSkillSet="2"
#! u30-expect-skills activeSkillSet="1"
fixture userdir=user1
frames 2
load-build "Builds/two_sets.xml"
frames 2
key-down CTRL
press 2
key-up CTRL
frames 3
move 480 50
click LEFTBUTTON
frames 2
move 480 92
frames 1
click LEFTBUTTON
frames 3
move 1000 300
frames 2
snapshot second
key-down CTRL
press z
key-up CTRL
frames 3
snapshot undone
move 647 50
click LEFTBUTTON
frames 3
move 640 525
frames 2
click LEFTBUTTON
frames 3
move 1000 300
frames 2
snapshot closed
