# stat rows of both builds, then scrolled down to the power report section (the controls and the
# list follow scrollY; summaryTotalContentHeight bounds the scroll bar), the cursor over the
# empty report list, scrolled back up.
#! u49-import Sub/allflame_exp_030.xml
#! u49-expect-text ^7Metric:
screen 1280 800 dpi 1
fixture userdir=../u46/user
frames 2
load-build "Builds/allflame_exp_001.xml"
frames 3
move 116 122
click LEFTBUTTON
frames 3
move 700 500
wheel down 10
frames 2
wheel down 10
frames 2
wheel down 10
frames 2
move 500 700
frames 2
move 700 500
wheel up 15
frames 2
