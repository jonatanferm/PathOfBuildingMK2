# Interactions of the "u11_single" gallery (U11).
frames 2
# hover the prompt edit: border and tooltip
move 120 30
frames 2
# click into the text: caret at the cursor (no select-all: the click set `drag`)
click LEFTBUTTON
type " World!"
type "~é"
frames 1
# shift+arrows, then copy the selection
key-down SHIFT
press LEFT
press LEFT
press LEFT
key-up SHIFT
key-down CTRL
press c
key-up CTRL
frames 1
# arrows collapse the selection; ctrl word jumps
press RIGHT
press HOME
key-down CTRL
press RIGHT
press RIGHT
press LEFT
key-up CTRL
press END
press LEFT
# backspace, ctrl+backspace, delete, ctrl+delete
press BACK
key-down CTRL
press BACK
key-up CTRL
press HOME
press DELETE
key-down CTRL
press DELETE
key-up CTRL
frames 1
# undo twice, redo once
key-down CTRL
press z
press z
press y
key-up CTRL
frames 1
# ctrl+a, ctrl+x (cut), ctrl+v (paste back), then paste a clipboard with \r\n and non-ASCII
key-down CTRL
press a
press x
press v
key-up CTRL
paste-clipboard "pasted\r\ntext é!"
key-down CTRL
press v
key-up CTRL
